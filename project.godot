; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="secretsanta25"
run/main_scene="uid://bq7a6mht4yorw"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TransitionManager="*res://Scenes/Autoloads/transition_manager.tscn"
SignalManager="*res://Scripts/Autoloads/signal_manager.gd"
AudioManager="*res://Scenes/Autoloads/audio_manager.tscn"
FullscreenManager="*res://Scripts/Autoloads/fullscreen_manager.gd"
ExtrasManager="*res://Scripts/Autoloads/extras_manager.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor]

movie_writer/fps=10

[file_customization]

folder_colors={
"res://Audio/": "red",
"res://Graphics/": "orange",
"res://Scenes/": "yellow",
"res://Scripts/": "green"
}

